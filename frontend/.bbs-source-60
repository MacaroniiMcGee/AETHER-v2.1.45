<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Board Blueprint Studio</title>
<style>
/* Layout: app shell. Top bar (project/boards/file), left tool strip, drawing sheet in the middle, tabbed inspector rail on the right, status bar. */
:root {
  /* Aether palette (config/ui.tsx): warm charcoal surfaces, amber accent, teal for selection */
  --bg: #14100D; --chrome: #1E1915; --panel: #241E19; --well: #1B1612; --raise: #2A241E;
  --ink: #F3ECE3; --ink2: #ADA294; --muted: #ADA294; --dim: #786D60; --line: #38302A; --line2: #4A3F36;
  --accent: #F0A73C; --accent-hi: #FFC66E; --accent-ink: #1B1612; --accent-soft: #3A2A14; --sel: #5FB7B0; --sel-soft: rgba(95,183,176,.16);
  --go: #2F4A36; --go-line: #8FB488; --go-ink: #DDF5E2;
  --warn: #E8B85A; --warn-soft: rgba(240,167,60,.14); --err: #E5796B; --err-line: #A84E3F; --err-ink: #F5C2B8; --err-soft: rgba(198,96,79,.15); --ok: #8FB488;
  --ui: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "Cascadia Mono", SFMono-Regular, Menlo, Consolas, monospace;
  --hover: rgba(243,236,227,.05);
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { height: 100%; margin: 0; }
body { background: var(--bg); color: var(--ink); font: 13px/1.4 var(--ui); overflow: hidden; }
button, select, input, textarea { font: inherit; color: inherit; }
button { background: var(--well); border: 1px solid var(--line2); color: var(--ink2); font-weight: 600; border-radius: 6px; padding: 5px 11px; cursor: pointer; white-space: nowrap; transition: color .12s, border-color .12s, background .12s; }
button:hover { color: var(--ink); border-color: var(--dim); }
button.primary { background: var(--go); border-color: var(--go-line); color: var(--go-ink); }
button.primary:hover { background: #36553E; }
button.danger { background: var(--err-soft); border-color: var(--err-line); color: var(--err-ink); }
button:disabled { opacity: .45; cursor: default; }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
input[type=text], input[type=number], input[type=date], select, textarea { background: var(--well); border: 1px solid var(--line2); border-radius: 6px; padding: 4px 8px; width: 100%; min-width: 0; color: var(--ink); }
input:focus, select:focus, textarea:focus { border-color: var(--accent); outline: none; }
input[type=checkbox], input[type=radio] { accent-color: var(--accent); }
::placeholder { color: var(--dim); }
textarea { font-family: var(--mono); font-size: 12px; resize: vertical; }
.app { display: grid; grid-template-rows: auto 1fr auto; height: 100%; }
/* top bar */
.top { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 12px; background: var(--chrome); border-bottom: 1px solid var(--line); }
.brand { font-weight: 700; letter-spacing: -.01em; display: flex; align-items: center; gap: 8px; margin-right: 6px; }
.brand { color: var(--accent); font-size: 14px; }
.brand i { width: 16px; height: 16px; border-radius: 4px; background: var(--accent-soft); box-shadow: inset 0 0 0 1px var(--accent); display: inline-block; position: relative; }
.brand i::after { content: ''; position: absolute; inset: 4px; border: 1.5px solid var(--accent); border-radius: 1px; }
.top .grp { display: flex; align-items: center; gap: 6px; }
.top .sep { width: 1px; height: 24px; background: var(--line2); margin: 0 2px; }
.top input#projName { width: 120px; }
.top select#boardSel { width: 165px; }
.top .vseg button { padding-left: 10px; padding-right: 10px; }
.spacer { flex: 1; }
details.menu { position: relative; }
details.menu > summary { list-style: none; cursor: pointer; background: var(--well); border: 1px solid var(--line2); color: var(--ink2); font-weight: 600; border-radius: 6px; padding: 5px 11px; }
details.menu > summary:hover { color: var(--ink); }
details.menu > summary::-webkit-details-marker { display: none; }
details.menu[open] > summary { border-color: var(--muted); }
details.menu .items { position: absolute; right: 0; top: calc(100% + 4px); z-index: 20; background: var(--panel); border: 1px solid var(--line2); border-radius: 8px; padding: 6px; min-width: 240px; box-shadow: 0 12px 32px rgba(0,0,0,.5); display: flex; flex-direction: column; gap: 2px; }
details.menu .items button { border: 0; background: transparent; color: var(--ink); text-align: left; padding: 7px 9px; font-weight: 600; }
details.menu .items button:hover { background: var(--raise); }
details.menu .items small { font-weight: 400; }
details.menu .items small { display: block; color: var(--muted); font-size: 11px; }
/* body */
.body { display: grid; grid-template-columns: 52px minmax(0, 1fr) 364px; min-height: 0; }
.tools { background: var(--chrome); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; padding: 8px 6px; align-items: center; }
.tools button { width: 38px; height: 38px; padding: 0; display: grid; place-items: center; border-color: transparent; background: transparent; color: var(--ink2); }
.tools button:hover { background: var(--raise); }
.tools button[aria-pressed=true] { background: var(--accent-soft); border-color: transparent; color: var(--accent-hi); box-shadow: inset 0 0 0 1px var(--accent); }
.tools svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.tools hr { width: 28px; border: 0; border-top: 1px solid var(--line); margin: 4px 0; }
.stage { position: relative; min-width: 0; min-height: 0; overflow: hidden; background: var(--bg); }
#svg { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; user-select: none; -webkit-user-select: none; display: block; }
#svg.pan { cursor: grab; } #svg.panning { cursor: grabbing; } #svg.dim { cursor: crosshair; }
.zoombox { position: absolute; right: 12px; bottom: 12px; display: flex; gap: 4px; }
.viewbox { position: absolute; left: 12px; bottom: 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; background: rgba(36,30,25,.94); border: 1px solid var(--line2); border-radius: 8px; box-shadow: 0 6px 20px rgba(0,0,0,.4); padding: 6px 10px; font-size: 12px; color: var(--muted); max-width: calc(100% - 24px); }
.viewbox label { display: inline-flex; gap: 5px; align-items: center; cursor: pointer; }
/* rail */
.rail { background: var(--chrome); border-left: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
.tabs { display: flex; border-bottom: 1px solid var(--line); }
.tabs { gap: 0; padding: 6px 4px 0; overflow-x: auto; scrollbar-width: none; }
.tabs::-webkit-scrollbar { display: none; }
.tabs button { flex: 1 0 auto; border: 0; border-radius: 6px 6px 0 0; background: transparent; padding: 8px 3px; font-size: 12px; font-weight: 500; color: var(--dim); }
.tabs button:hover { color: var(--ink2); }
.tabs button[aria-selected=true] { font-weight: 600; color: var(--ink); background: var(--raise); box-shadow: inset 0 -2px 0 var(--accent); }
.tabs .badge { font-size: 10px; background: var(--err-soft); color: var(--err); border-radius: 999px; padding: 0 5px; margin-left: 3px; }
.pane { overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 12px; min-height: 0; flex: 1; }
.sect { display: flex; flex-direction: column; gap: 8px; }
.sect + .sect { border-top: 1px solid var(--line); padding-top: 12px; }
h3 { margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }
label.f { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: var(--muted); }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.row3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
.btns { display: flex; flex-wrap: wrap; gap: 6px; }
.chk { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); cursor: pointer; }
.swatches { display: flex; flex-wrap: wrap; gap: 5px; }
.sw { width: 24px; height: 24px; border-radius: 5px; padding: 0; border: 2px solid transparent; box-shadow: inset 0 0 0 1px rgba(0,0,0,.2); }
.sw[aria-pressed=true] { border-color: var(--accent-hi); }
.hint { color: var(--muted); font-size: 12px; margin: 0; line-height: 1.45; }
.grid5 { display: grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap: 5px; }
.grid5 button { padding: 6px 0; font-family: var(--mono); font-size: 12px; }
.grid3 { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 5px; }
.list { display: flex; flex-direction: column; gap: 1px; }
.list button { display: flex; align-items: center; gap: 8px; border: 0; text-align: left; background: transparent; color: var(--ink); font-weight: 400; padding: 4px 6px; font-size: 12px; border-radius: 5px; }
.list button:hover { background: var(--raise); }
.list button[aria-current=true] { background: var(--sel-soft); box-shadow: inset 2px 0 0 var(--sel); }
.list .dot { width: 10px; height: 10px; border-radius: 2px; flex: none; }
.list .meta { margin-left: auto; font-family: var(--mono); font-size: 10px; color: var(--muted); }
.grpname { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding: 6px 6px 2px; }
table.pins { width: 100%; border-collapse: collapse; font-size: 12px; }
table.pins th { text-align: left; font-weight: 600; color: var(--dim); font-size: 11px; padding: 4px; border-bottom: 1px solid var(--line); position: sticky; top: -12px; background: var(--chrome); }
table.pins td { padding: 2px 4px; border-bottom: 1px solid var(--line); vertical-align: middle; }
table.pins td.n { font-family: var(--mono); color: var(--muted); font-variant-numeric: tabular-nums; }
table.pins input { padding: 2px 5px; font-family: var(--mono); font-size: 12px; }
table.pins tr.blk td { background: var(--raise); font-weight: 600; cursor: pointer; }
.lbl:hover text { fill: #0b84ff; }
.libitem { background: var(--well); color: var(--ink2); }
.libitem:hover { background: var(--raise); color: var(--ink); border-color: var(--dim); }
.libitem svg { color: var(--accent); }
.libcat { font: 600 10px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 6px 0 4px; }
.libgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px; }
.libitem { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 6px 4px; white-space: normal; font-size: 11px; line-height: 1.2; text-align: center; min-height: 74px; }
.libitem svg { width: 34px; height: 34px; flex: none; }
.vseg { display: inline-flex; gap: 2px; padding: 2px; background: var(--well); border: 1px solid var(--line); border-radius: 8px; }
.vseg button { border: 0; border-radius: 6px; padding: 5px 13px; background: transparent; color: var(--dim); }
.vseg button:hover { color: var(--ink2); }
.vseg button[aria-pressed=true] { background: var(--accent-soft); color: var(--accent-hi); box-shadow: inset 0 0 0 1px var(--accent); }
.pinhot { fill: #ffffff; fill-opacity: .6; stroke: #0b84ff; stroke-width: .25; cursor: crosshair; }
.pinhot.used { fill: #0b84ff; fill-opacity: .18; }
.pinhot:hover { fill: #0b84ff; fill-opacity: .65; }
.pinhot.pend { fill: #e8651a; fill-opacity: .95; stroke: #e8651a; }
body.wiring [data-tool="dim"], body.site [data-tool="dim"], body.map [data-tool="dim"], body.enc [data-tool="dim"] { opacity: .35; pointer-events: none; }
body.enc #updLayout, body.enc .viewbox { display: none; }
body:not(.wiring) .tabs [data-tab="power"] { display: none; }
body:not(.wiring) [data-tool="box"] { display: none; }
body:not(.wiring) .wonly { display: none; }
.wonly { display: inline-flex; gap: 4px; }
.wonly button { font-size: 12px; padding: 2px 8px; }
.wonly button[aria-pressed=true] { background: var(--sel-soft); color: var(--sel); border-color: var(--sel); }
.wonly kbd { font-size: 10px; opacity: .7; }
body.wiring #updLayout, body.site #updLayout, body.map #updLayout { display: none; }
.li { display: flex; align-items: center; gap: 6px; width: 100%; text-align: left; border: 0; background: transparent; padding: 4px 6px; border-radius: 5px; font-size: 12px; cursor: pointer; }
.li:hover { background: var(--hover); }
.li[aria-current=true] { background: var(--sel-soft); }
#updLayout.dirty { border-color: var(--accent); color: var(--accent-hi); background: var(--accent-soft); }
#clearAll { color: var(--err); }
.issue { display: flex; gap: 8px; align-items: flex-start; border: 0; text-align: left; background: var(--well); color: var(--ink); font-weight: 400; border: 1px solid var(--line); border-radius: 6px; padding: 7px 9px; white-space: normal; }
.issue .sev { font-size: 10px; font-weight: 700; text-transform: uppercase; border-radius: 4px; padding: 1px 5px; flex: none; margin-top: 1px; }
.sev.err { background: var(--err-soft); color: var(--err); } .sev.warn { background: var(--warn-soft); color: var(--warn); }
.okmsg { color: var(--ok); font-weight: 600; }
.status { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 5px 12px; background: var(--well); border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); font-family: var(--mono); font-variant-numeric: tabular-nums; }
.status .err { color: var(--err); } .status .ok { color: var(--ok); }
.toast { position: fixed; left: 50%; bottom: 42px; transform: translateX(-50%); background: var(--panel); color: var(--accent-hi); border: 1px solid var(--accent); box-shadow: 0 8px 24px rgba(0,0,0,.5); padding: 8px 14px; border-radius: 6px; font-size: 13px; z-index: 50; max-width: 90vw; }
dialog { border: 1px solid var(--line2); border-radius: 10px; box-shadow: 0 20px 50px rgba(0,0,0,.6); background: var(--panel); color: var(--ink); padding: 18px; width: min(420px, 92vw); }
dialog::backdrop { background: rgba(10,8,6,.65); }
dialog h2 { margin: 0 0 10px; font-size: 16px; color: var(--accent); }
dialog .opts { display: flex; flex-direction: column; gap: 8px; margin: 10px 0 14px; }
dialog .opt { display: flex; gap: 10px; align-items: flex-start; border: 1px solid var(--line); border-radius: 8px; padding: 10px; cursor: pointer; }
dialog .opt small { display: block; color: var(--muted); }
kbd { font-family: var(--mono); font-size: 11px; border: 1px solid var(--line2); border-bottom-width: 2px; border-radius: 4px; padding: 0 4px; background: var(--well); color: var(--ink2); }
.keys { display: grid; grid-template-columns: auto 1fr; gap: 4px 10px; font-size: 12px; color: var(--muted); }
#print { display: none; }
/* Manage boards */
#boardsDlg { width: min(720px, 94vw); max-height: 86vh; display: none; flex-direction: column; gap: 10px; padding: 18px; }
#boardsDlg[open] { display: flex; }
#boardsDlg h2 { margin: 0; }
.mb-tools { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
.mb-tools input[type=text] { flex: 1 1 200px; width: auto; }
.mb-tools button { padding: 4px 9px; font-size: 12px; }
.mb-list { overflow: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--well); min-height: 160px; }
.mb-grp { position: sticky; top: 0; background: var(--panel); color: var(--accent); font: 700 10px var(--ui); letter-spacing: .08em; text-transform: uppercase; padding: 6px 10px; border-bottom: 1px solid var(--line); }
.mb-row { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 6px 10px; border-bottom: 1px solid var(--line); cursor: pointer; }
.mb-row:hover { background: var(--raise); }
.mb-row.on { background: var(--err-soft); }
.mb-row .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
.mb-row .nm small { color: var(--dim); margin-left: 6px; }
.mb-row .tags { display: flex; gap: 4px; font: 11px var(--mono); color: var(--dim); white-space: nowrap; }
.mb-tag { border: 1px solid var(--line2); border-radius: 999px; padding: 0 6px; }
.mb-tag.open { color: var(--accent-hi); border-color: var(--accent); }
.mb-tag.site { color: var(--sel); border-color: var(--sel); }
.mb-foot { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.mb-foot .hint { flex: 1 1 240px; }
.iconbtn { display: inline-flex; align-items: center; gap: 6px; }
.iconbtn[hidden] { display: none; }
#fullBtn { padding: 5px 8px; } #fullBtn span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.iconbtn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
#fullBtn[aria-pressed=true] { background: var(--accent-soft); color: var(--accent-hi); border-color: var(--accent); }
/* Embedded in Aether (Setup & Tools → Tools): Aether's tab bar already names the tool */
body.embed .brand { display: none; }
body.embed .top { padding: 6px 10px; }
.top { background: var(--chrome); }
::-webkit-scrollbar { width: 10px; height: 10px; } ::-webkit-scrollbar-thumb { background: var(--line2); border-radius: 6px; border: 2px solid var(--chrome); } ::-webkit-scrollbar-track { background: transparent; }
@media (max-width: 900px) { .body { grid-template-columns: 46px minmax(0,1fr); grid-template-rows: minmax(0,1fr) 45%; } .rail { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--line); } }
@media print {
  @page { margin: 10mm; }
  body { overflow: visible; background: #fff; }
  .app, .toast, dialog { display: none !important; }
  #print { display: block; color: #000; font-family: Arial, sans-serif; }
  #print svg { width: 100%; height: auto; max-height: 92vh; }
  #print table { width: 100%; border-collapse: collapse; font-size: 9pt; margin-top: 8mm; page-break-before: always; }
  #print th, #print td { border: 1px solid #999; padding: 2px 5px; text-align: left; }
}
</style>
</head>
<body>
<div class="app">
  <header class="top">
    <div class="brand"><i aria-hidden="true"></i>Board Blueprint Studio</div>
    <div class="grp"><input type="text" id="projName" aria-label="Project name" title="Project name"></div>
    <span class="sep"></span>
    <div class="grp">
      <select id="boardSel" aria-label="Board"></select>
      <button id="bNew" title="Add a board to this project">New board</button>
      <button id="bDup" title="Duplicate this board">Duplicate</button>
      <button id="bMng" title="Pick several boards to delete at once">Manage…</button>
      <button id="bDel" class="danger" title="Delete this board">Delete</button>
    </div>
    <span class="sep"></span>
    <div class="vseg" role="group" aria-label="View"><button data-mode="layout" aria-pressed="true" title="Board layout">Layout</button><button data-mode="wiring" aria-pressed="false" title="Wiring diagram">Wiring</button><button data-mode="site" aria-pressed="false" title="Site riser: every controller and downstream board">Site</button><button data-mode="map" aria-pressed="false" title="Site map: floor plan survey, comm closets, door runs and the exploded wiring overview">Map</button><button data-mode="enc" aria-pressed="false" title="Enclosure wiring: the controller, its downstream boards, power supplies, ACM8, batteries, tamper and lighting in an Altronix Trove">Enclosure</button></div>
    <div class="spacer"></div>
    <div class="grp">
      <button id="undo" title="Undo (Ctrl+Z)">Undo</button>
      <button id="redo" title="Redo (Ctrl+Y)">Redo</button>
      <button id="clearAll" title="Clear everything on this page (Undo brings it back)">Clear all</button>
      <span class="sep"></span>
      <button id="open" title="Open a project or layout file (.json)">Open…</button>
      <button id="updLayout" title="Save just this board's layout as the standard for its model; the rest of the project is not touched">Update layout</button>
      <button id="saveProj" class="primary" title="Save the whole project as a file (Ctrl+S)">Save project</button>
      <details class="menu" id="exportMenu">
        <summary>Export ▾</summary>
        <div class="items">
          <button data-exp="svg">SVG drawing<small>The current view: layout or wiring diagram</small></button>
          <button data-exp="png">PNG image<small>High resolution, for slides and Confluence</small></button>
          <button data-exp="csv">Pin list (CSV)<small>Every terminal pin, for the datasheet and manual</small></button>
          <button data-exp="wires">Wire schedule (CSV)<small>Every wire end to end, plus the device list</small></button>
          <button data-exp="power">Power budget (CSV)<small>Supplies, loads, battery size and voltage drop</small></button>
          <button data-exp="tests">Test and commissioning sheet (CSV)<small>Expected meter readings and function tests per device</small></button>
          <button data-exp="bom">Bill of materials (CSV)<small>Devices, cable footage, EOL resistors, ferrules, batteries</small></button>
          <button data-exp="print">Print or save as PDF<small>Drawing plus pin table</small></button>
          <button data-exp="allsvg">SVG of every board<small>One file per board</small></button>
        </div>
      </details>
      <button id="fullBtn" class="iconbtn" title="Full screen (Shift+F). Esc to leave." aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg><span>Full screen</span></button>
    </div>
  </header>

  <div class="body">
    <nav class="tools" aria-label="Tools">
      <button data-tool="select" aria-pressed="true" title="Select and move (V)"><svg viewBox="0 0 24 24"><path d="M5 3l14 8-6 2-3 6z"/></svg></button>
      <button data-tool="pan" aria-pressed="false" title="Pan (H, or hold Space)"><svg viewBox="0 0 24 24"><path d="M8 13V5a1.5 1.5 0 013 0v6m0-1V3.5a1.5 1.5 0 013 0V11m0-6a1.5 1.5 0 013 0v7m0-3a1.5 1.5 0 013 0v5a7 7 0 01-7 7h-1a7 7 0 01-5.6-2.8L4 15.5a1.5 1.5 0 012.3-2z"/></svg></button>
      <button data-tool="box" aria-pressed="false" title="Box select wires and devices (B). Then bundle them into a jacket from Properties."><svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="1" stroke-dasharray="3 2"/><path d="M8 12h8M8 9h8M8 15h8"/></svg></button>
      <button data-tool="dim" aria-pressed="false" title="Dimension line (M)"><svg viewBox="0 0 24 24"><path d="M3 7v10M21 7v10M3 12h18M6 9l-3 3 3 3M18 9l3 3-3 3"/></svg></button>
      <hr>
      <button id="tFit" title="Fit drawing (F)"><svg viewBox="0 0 24 24"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg></button>
