// ---------------------------------------------------------------- sign-in through Aether (Update 58)
// The browser can't call OnCafe from this page, but Aether's backend on the Pi can: it signs in to OnCafe with the
// user's username and password, keeps only a 48-hour refresh token on the Pi, and returns the same blueprint-site data
// the connector script produces. Available only when the studio is opened from Aether.
function aetherBase() { if (!/^https?:$/.test(location.protocol) || !location.hostname) return null; return location.port === '3001' ? location.origin : `${location.protocol}//${location.hostname}:3001`; }
async function aetherCall(p, body) {
  const base = aetherBase(); if (!base) { const e = new Error('Open the studio from Aether to sign in through it.'); e.code = 'no_aether'; throw e; }
  let r; try { r = await fetch(base + '/api/oncafe/' + p, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) } : { cache: 'no-store' }); }
  catch (e) { const x = new Error('Aether did not answer at ' + base + '.'); x.code = 'no_aether'; throw x; }
  let j = {}; try { j = await r.json(); } catch (e) { /* not JSON: an older Aether without this route */ }
  if (r.status === 404 && !j.error) { const e = new Error('This Aether does not have OnCafe sign-in yet (Update 58).'); e.code = 'no_aether'; throw e; }
  if (!r.ok || !j.success) { const e = new Error(j.error || ('Aether answered HTTP ' + r.status)); e.code = j.code; e.state = j; throw e; }
  return j;
}
