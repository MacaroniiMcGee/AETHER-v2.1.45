  if (legs === 'soic') { const n = 4, pitch = (h - 1.4) / n; for (let i = 0; i < n; i++) { s += gR(x, y + 0.7 + i * pitch + pitch * 0.3, 0.9, pitch * 0.4, MT) + gR(x + w - 0.9, y + 0.7 + i * pitch + pitch * 0.3, 0.9, pitch * 0.4, MT); } s += gR(x + 0.9, y, w - 1.8, h, BK, BKE, 0.2); s += gC(x + 1.7, y + 0.9, 0.3, '#6b7176'); }
  else { const L = 1, n = Math.max(6, Math.round((w - 2 * L) / 0.5 / 2)); const step = (w - 2 * L - 1) / n;
    for (let i = 0; i < n; i++) { const o = L + 0.5 + i * step + step * 0.3, t = step * 0.4; s += gR(x + o, y, t, L, MT) + gR(x + o, y + h - L, t, L, MT) + gR(x, y + o, L, t, MT) + gR(x + w - L, y + o, L, t, MT); }
    s += gR(x + L, y + L, w - 2 * L, h - 2 * L, BK, BKE, 0.2) + gC(x + L + 1, y + L + 1, 0.35, '#6b7176'); }
  return s;
}
const CATALOG = [
  // ---------------- Network
  { key: 'rj45', cat: 'Network', name: 'RJ45 jack', w: 16, h: 21.3, cap: 'LAN', draw: (x, y, w, h) => gR(x, y, w, h, MT, MTD, 0.3, 0.6) + rjPort(x, y, w, h, false) },
  { key: 'rj45led', cat: 'Network', name: 'RJ45 with LEDs (MagJack)', w: 16, h: 21.3, cap: 'LAN', leds: true, draw: (x, y, w, h, S, p) => gR(x, y, w, h, MT, MTD, 0.3, 0.6) + gT(x + w / 2, y + 4.5, 1.6, 'MAG', MTD) + rjPort(x, y, w, h, true, p.color, p.color2) },
  { key: 'rj45poe', cat: 'Network', name: 'RJ45 PoE input (MagJack)', w: 16, h: 21.3, cap: 'PoE+', leds: true, draw: (x, y, w, h, S, p) => gR(x, y, w, h, MT, MTD, 0.3, 0.6) + gT(x + w / 2, y + 4.5, 1.8, 'PoE', MTD, 'middle', 700) + rjPort(x, y, w, h, true, p.color, p.color2) },
  { key: 'rj45x2', cat: 'Network', name: 'RJ45 2-port', w: 32.5, h: 21.3, cap: 'LAN 1 / LAN 2', leds: true, draw: (x, y, w, h, S, p) => gR(x, y, w, h, MT, MTD, 0.3, 0.6) + rjPort(x, y, 16, h, true, p.color, p.color2) + rjPort(x + 16.5, y, 16, h, true, p.color, p.color2) },
  { key: 'sfp', cat: 'Network', name: 'SFP cage (fiber)', w: 14, h: 48.7, cap: 'SFP', draw: (x, y, w, h) => { let s = gR(x, y, w, h, MT, MTD, 0.3, 0.4); for (let i = 1; i < 8; i++) s += `<line x1="${r2(x + 1)}" y1="${r2(y + i * 4.6)}" x2="${r2(x + w - 1)}" y2="${r2(y + i * 4.6)}" stroke="${MTD}" stroke-width="0.2"/>`; return s + gR(x + 1.4, y + h - 9, w - 2.8, 8.4, BK, BKE, 0.2); } },
  { key: 'sma', cat: 'Network', name: 'SMA antenna connector (edge)', w: 6.4, h: 10.5, cap: 'ANT', draw: (x, y, w, h) => gR(x, y, w, 6.4, GOLD, '#9c7d1f', 0.25) + gR(x + 1.5, y + 6.4, 3.4, h - 6.4, GOLD, '#9c7d1f', 0.25) + gC(x + w / 2, y + 3.2, 1.6, '#f1f1ee', '#9c7d1f', 0.2) + gC(x + w / 2, y + 3.2, 0.5, GOLD) },
