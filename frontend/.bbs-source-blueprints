const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const r2 = v => Math.round(v * 100) / 100;
let seq = 0; const nid = () => 'p' + Date.now().toString(36) + (seq++).toString(36);
const today = () => new Date().toISOString().slice(0, 10);

// ====================================================================== component library
// Each entry is drawn in its base orientation (mating face / cable side toward the bottom edge) at typical real size in mm.
const MT = '#c4c9ce', MTD = '#7f868d', BK = '#2b2e31', BKE = '#121416', GOLD = '#d4af37', SCR = '#1b2a3a';
const gR = (x, y, w, h, f, st, sw = 0.25, rx = 0, extra = '') => `<rect x="${r2(x)}" y="${r2(y)}" width="${r2(w)}" height="${r2(h)}"${rx ? ` rx="${r2(rx)}"` : ''} fill="${f}"${st ? ` stroke="${st}" stroke-width="${sw}"` : ''}${extra}/>`;
const gC = (x, y, r, f, st, sw = 0.25, extra = '') => `<circle cx="${r2(x)}" cy="${r2(y)}" r="${r2(r)}" fill="${f}"${st ? ` stroke="${st}" stroke-width="${sw}"` : ''}${extra}/>`;
