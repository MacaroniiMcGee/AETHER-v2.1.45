  for (let i = 0; i < 8; i++) s += gR(x + w / 2 - 3.15 + i * 0.85, y + h - 8.6, 0.35, 2.2, GOLD);
  if (leds) s += gR(x + 0.6, y + h - 2.6, 1.6, 2, c1 || '#2fbf5f', BKE, 0.15) + gR(x + w - 2.2, y + h - 2.6, 1.6, 2, c2 || '#f2a51d', BKE, 0.15);
  return s;
}
function icBody(x, y, w, h, legs, S) { // legs: 'soic' | 'qfp'
