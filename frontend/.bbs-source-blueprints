const ledKey = p => p.color ? (p.color2 ? p.color + '|' + p.color2 : p.color) : '';
const ledKeyName = k => k.split('|').map(ledName).join(' / ');
const SHEETS = {
  paper: { bg: '#ffffff', board: '#fbfbfa', edge: '#8d959c', inner: '#f0f1f0', feat: '#fbfbfa', dark: '#9aa2a9', text: '#5d6873', label: '#1d2329', title: '#1d2329', dim: '#c2410c', grid: '#e8ebee', grid2: '#d6dbe0', tb: '#1d2329', tbLine: '#8d959c' },
