    if (has(/maglock/) && !has(/rex_button|egress/)) out.push({ sev: 'warn', id: e.id, msg: `${tag}: add a push-to-exit button within 5 ft of the door that cuts lock power for at least 30 s (NFPA 101 / IBC).` });
