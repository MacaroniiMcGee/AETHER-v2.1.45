  $('#newW').disabled = $('#newH').disabled = !!T || $('#newTpl').value === 'copy'; }
$('#newTpl').addEventListener('change', syncTpl);
$('#newCancel').addEventListener('click', () => $('#newDlg').close());
$('#updLayout').addEventListener('click', () => { const b = B(), had = !!savedLayout(layoutKey(b)); saveLayout(b); updLayoutState(); if (ui.mode === 'layout') renderPane();
  const n = sameModelBoards(b).length; toast(`${had ? 'Updated' : 'Saved'} the standard ${layoutLabel(layoutKey(b))} layout.${n ? ` ${n} other board${n > 1 ? 's' : ''} of this model can follow it: see the board panel.` : ''}`); });
$('#newOk').addEventListener('click', () => {
  const name = $('#newName').value.trim() || 'New board', tpl = $('#newTpl').value, T = BOARD_TEMPLATES.find(t => t.key === tpl);
  const w = Math.max(10, +$('#newW').value || 120), h = Math.max(10, +$('#newH').value || 150);
  let b = T ? makeFromLibrary(T.key, name) : tpl === 'copy' ? cloneBoard(B(), name) : blankWithHoles(name, w, h);
  normBoard(b);
  push(); project.boards.push(b); project.active = b.id; ui.sel.clear(); ui.boardSel = false; $('#newDlg').close(); renderAll(); fit(); renderCanvas();
});
$('#bDup').addEventListener('click', () => { push(); const b = cloneBoard(B(), B().name + ' copy'); project.boards.push(b); project.active = b.id; ui.sel.clear(); renderAll(); toast('Board duplicated'); });
let delArm = 0;
// ---- Manage boards: tick several boards and delete them in one step (one Undo brings them all back)
(function manageBoards() {
  const dlg = $('#boardsDlg'), list = $('#mbList'), find = $('#mbFind'), del = $('#mbDel'), note = $('#mbNote');
  const pick = new Set(); let arm = 0;
  const groupOf = b => { const onSite = (project.site && project.site.nodes || []).some(n => n.board === b.id); const t = BOARD_TEMPLATES.find(x => x.name === b.name);
    return onSite ? 'Site: ' + ((project.site || {}).name || 'Site') : t ? t.group : 'My boards'; };
  const nodeOf = b => (project.site && project.site.nodes || []).find(n => n.board === b.id);
  const wired = b => b.wiring && ((b.wiring.devices || []).length || (b.wiring.wires || []).length);
  const shown = () => { const q = find.value.trim().toLowerCase(); return project.boards.filter(b => !q || (b.name + ' ' + groupOf(b) + ' ' + (b.tpl || '')).toLowerCase().includes(q)); };
  function draw() {
    const S = shown(), groups = new Map(); S.forEach(b => { const g = groupOf(b); if (!groups.has(g)) groups.set(g, []); groups.get(g).push(b); });
    list.innerHTML = S.length ? [...groups].map(([g, bs]) => `<div class="mb-grp">${esc(g)} · ${bs.length}</div>` + bs.map(b => { const n = nodeOf(b), on = pick.has(b.id), W = b.wiring || {};
      return `<label class="mb-row${on ? ' on' : ''}" role="option" aria-selected="${on}"><input type="checkbox" data-id="${esc(b.id)}"${on ? ' checked' : ''}>
        <span class="nm">${esc(b.name)}<small>${r2(b.w)} × ${r2(b.h)} mm</small></span>
        <span class="tags">${b.id === project.active ? '<span class="mb-tag open">open</span>' : ''}${n ? `<span class="mb-tag site">${n.role === 'controller' ? 'controller' : 'downstream'}</span>` : ''}<span class="mb-tag">${(W.devices || []).length} dev · ${(W.wires || []).length} wires</span></span></label>`; }).join('')).join('')
      : '<p class="hint" style="padding:12px">No boards match.</p>';
    const n = pick.size, all = n >= project.boards.length, kids = [...pick].map(id => project.boards.find(b => b.id === id)).filter(Boolean).map(nodeOf).filter(x => x && x.role === 'controller')
      .flatMap(c => project.site.nodes.filter(k => k.parent === c.id && !pick.has(k.board))).length;
    del.disabled = !n || all; arm = 0;
    del.textContent = n ? `Delete ${n} board${n > 1 ? 's' : ''}` : 'Delete';
    note.textContent = all ? 'Keep at least one board: untick one to delete the rest.' : !n ? `${project.boards.length} boards in this project. Tick the ones to remove.`
      : `${n} selected.${kids ? ` ${kids} downstream board${kids > 1 ? 's come' : ' comes'} off the riser with ${kids > 1 ? 'their' : 'its'} controller (the board${kids > 1 ? 's stay' : ' stays'}).` : ''} Undo brings them back.`;
  }
  list.addEventListener('change', e => { const id = e.target.dataset.id; if (!id) return; e.target.checked ? pick.add(id) : pick.delete(id); draw(); });
  find.addEventListener('input', draw);
  dlg.querySelectorAll('[data-mbsel]').forEach(btn => btn.addEventListener('click', () => { const k = btn.dataset.mbsel;
    if (k === 'none') pick.clear();
    else if (k === 'shown') shown().forEach(b => pick.add(b.id));
    else if (k === 'empty') shown().forEach(b => { if (!wired(b) && !nodeOf(b)) pick.add(b.id); });
    else if (k === 'dupes') { const seen = new Set(); project.boards.forEach(b => { const key = b.name.trim().toLowerCase(); if (seen.has(key)) pick.add(b.id); else seen.add(key); }); }
    draw(); }));
  del.addEventListener('click', () => {
    if (!pick.size || pick.size >= project.boards.length) return;
    if (Date.now() - arm > 3000) { arm = Date.now(); del.textContent = `Click again to delete ${pick.size}`; setTimeout(() => { if (arm && Date.now() - arm >= 3000) draw(); }, 3100); return; }
    push(); const n = pick.size;
    const S = project.site; if (S && S.nodes) [...pick].forEach(id => { const node = S.nodes.find(k => k.board === id); if (node) siteRemove(node, false); });
    project.boards = project.boards.filter(b => !pick.has(b.id));
    if (!project.boards.some(b => b.id === project.active)) project.active = project.boards[0].id;
    pick.clear(); ui.sel.clear(); dlg.close(); renderAll(); fit(); renderCanvas(); toast(`Deleted ${n} board${n > 1 ? 's' : ''}. Undo brings ${n > 1 ? 'them' : 'it'} back.`);
  });
  $('#mbClose').addEventListener('click', () => dlg.close());
  $('#bMng').addEventListener('click', () => { pick.clear(); find.value = ''; draw(); dlg.showModal(); find.focus(); });
})();
$('#bDel').addEventListener('click', () => {
  if (project.boards.length < 2) return;
  if (Date.now() - delArm > 3000) { delArm = Date.now(); $('#bDel').textContent = 'Click again to delete'; setTimeout(() => $('#bDel').textContent = 'Delete', 3000); return; }
  push(); const name = B().name; project.boards = project.boards.filter(b => b.id !== project.active); project.active = project.boards[0].id; ui.sel.clear(); $('#bDel').textContent = 'Delete'; renderAll(); fit(); renderCanvas(); toast(`Deleted ${name}. Undo brings it back.`);
});

// ====================================================================== misc wiring
document.querySelectorAll('[data-mode]').forEach(bt => bt.addEventListener('click', () => setMode(bt.dataset.mode)));
$('#undo').addEventListener('click', undo); $('#redo').addEventListener('click', redo);
document.querySelectorAll('[data-tool]').forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool)));
$('#tFit').addEventListener('click', () => { fit(); renderCanvas(); }); $('#tZin').addEventListener('click', () => zoomBy(0.8)); $('#tZout').addEventListener('click', () => zoomBy(1.25));
$('#tHelp').addEventListener('click', () => $('#helpDlg').showModal()); $('#helpClose').addEventListener('click', () => $('#helpDlg').close());
document.querySelectorAll('.tabs button').forEach(t => t.addEventListener('click', () => { ui.tab = t.dataset.tab; renderPane(); }));
let clearArm = 0;
$('#clearAll').addEventListener('click', () => {
  if (ui.mode === 'enc') { push(); encCfg(encRoot()).pos = {}; changed(); toast('Enclosure layout reset to automatic. Undo brings your arrangement back.'); return; }
  const what = ui.mode === 'map' ? 'the map (plan, doors, closets and cable paths; boards and wiring stay)' : ui.mode === 'site' ? 'the site riser' : ui.mode === 'wiring' ? 'all devices, doors, zones and wiring on this board' : 'every part on this board layout';
  if (Date.now() - clearArm > 3500) { clearArm = Date.now(); $('#clearAll').textContent = 'Click again to clear'; toast(`Click Clear all again to remove ${what}. Undo brings it back.`); setTimeout(() => { $('#clearAll').textContent = 'Clear all'; }, 3500); return; }
  clearArm = 0; $('#clearAll').textContent = 'Clear all'; push(); const b = B();
  if (ui.mode === 'map') { const M = mapData(); M.plan = { kind: 'none' }; M.doors = []; M.closets = []; M.corridors = []; site().nodes.forEach(n => delete n.closet); toast('Map cleared. Load the 50-door sample or upload a plan from the Add tab; Undo brings it back.'); }
  else if (ui.mode === 'site') { site().nodes = []; toast('Site riser cleared. The boards stay in the board list; Undo brings the riser back.'); }
  else if (ui.mode === 'wiring') { Object.assign(b.wiring, { devices: [], wires: [], cables: [], entities: [] }); toast('Wiring cleared. Undo brings it back.'); }
  else { const gone = new Set(b.parts.map(p => p.id)); b.parts = []; b.wiring.wires = b.wiring.wires.filter(w => !gone.has(w.a.p) && !gone.has(w.b.p)); pruneCables(b); toast('Layout cleared. Undo brings it back.'); }
  ui.sel.clear(); fit(); changed();
});
$('#vBox').addEventListener('click', () => { setTool(ui.tool === 'box' ? 'select' : 'box'); toast(ui.tool === 'box' ? 'Box select: drag over the wires to bundle. V returns to Select.' : 'Select tool'); });
$('#vTwist').addEventListener('click', () => { const w = wSelected().wires; wTwist(w); });
$('#vBundle').addEventListener('click', () => { const w = wSelected().wires; if (w.length < 2) return toast('Select two or more wires first (Box select or Shift-click).'); wBundle(w, { jacket: ui.bundleJacket }); });
[['vGrid', 'grid'], ['vLabels', 'labels'], ['vDims', 'dims'], ['vTrace', 'trace']].forEach(([id, k]) => $('#' + id).addEventListener('change', e => { ui[k] = e.target.checked; renderCanvas(); }));
$('#snap').addEventListener('change', e => { ui.snap = e.target.value; renderCanvas(); });
$('#pickMode').addEventListener('change', e => { ui.pick = e.target.value; if (ui.pick === 'term') { ui.sel = new Set(selected().filter(p => p.type === 'term').map(p => p.id)); ui.boardSel = false; } changed(); });
document.addEventListener('click', e => { const m = $('#exportMenu'); if (m.open && !m.contains(e.target)) m.open = false; });
let toastT;
function toast(msg) { const t = $('#toast'); t.textContent = msg; t.hidden = false; clearTimeout(toastT); toastT = setTimeout(() => t.hidden = true, 3200); }
new ResizeObserver(() => { if (!ui.view) fit(); else applyView(); renderCanvas(); }).observe($('#stage'));

window.BBS = { get project() { return project; }, exportSVG: () => exportSVG(B()), ui };
renderAll(); fit(); renderCanvas();
</script>
</body>
