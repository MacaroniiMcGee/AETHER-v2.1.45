      "door": 1,
      "pins": {
        "tx": 12,
        "rx": 13
      },
      "address": 0,
      "enabled": true
    },
    {
      "id": "osdp-2",
      "name": "Back OSDP",
      "door": 2,
      "pins": {
        "tx": 16,
        "rx": 26
      },
      "address": 1,
      "enabled": true
    },
    {
      "id": "osdp-3",
      "name": "Side OSDP",
      "door": 3,
      "pins": {
        "tx": 19,
        "rx": 20
      },
      "address": 2,
      "enabled": true
    },
    {
      "id": "osdp-4",
      "name": "Elevator OSDP",
      "door": 4,
      "pins": {
        "tx": 21,
        "rx": 4
      },
      "address": 3,
      "enabled": true
    }
  ],
  "sequent_ioplus": {
    "enabled": true,
    "type": "IOplus Home Automation",
    "interface": "i2c",
    "i2c_address": "0x28",
    "pins": {
      "sda": 2,
      "scl": 3
