    "spi_rs485": [],
    "wiegand_rx": [
      17,
      27,
      22,
      23,
      24,
      25,
      5,
      6
    ],
    "osdp_serial": [
      12,
      13,
      16,
      26,
      19,
      20,
      21,
      4
    ]
  },
  "availableIOPins": [],
  "notes": [
    "VERSION 5.0 - SEQUENT IOPLUS CONFIGURATION",
    "",
    "=== HARDWARE ===",
    "Sequent IOplus: 8 Relays + 8 Supervised Inputs + 8 Digital Inputs",
    "I2C Address: 0x28 (GPIO 2, 3)",
    "",
    "=== PIN ALLOCATION ===",
    "Hardware Reserved (I2C): 2, 3",
    "Wiegand Readers (RX): 17,27,22,23,24,25,5,6 (4 readers)",
    "OSDP Readers (Serial): 12,13,16,26,19,20,21,4 (4 readers)",
    "",
    "=== DOOR MAPPING ===",
    "Door 1: Wiegand(17,27) | OSDP(12,13) | Relay 0 | Input 0 | ADC 1",
    "Door 2: Wiegand(22,23) | OSDP(16,26) | Relay 1 | Input 1 | ADC 2",
    "Door 3: Wiegand(24,25) | OSDP(19,20) | Relay 2 | Input 2 | ADC 3",
    "Door 4: Wiegand(5,6)   | OSDP(21,4)  | Relay 3 | Input 3 | ADC 4",
    "",
    "=== I/O CONTROL ===",
    "All relay/input control via Sequent IOplus (not direct GPIO)",
    "Use /api/gpio endpoints for relay control",
    "Use /api/supervision endpoints for supervised zone monitoring",
    "",
    "=== NO GENERAL PURPOSE I/O ===",
    "All GPIO pins are reserved for specific functions.",
    "No pins available for general I/O expansion."
